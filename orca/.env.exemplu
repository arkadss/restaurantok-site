# Copiază în orca/.env (fișierul .env nu se comite; .gitignore îl exclude) și completează.
# Nicio valoare de aici nu trebuie să ajungă în repo sau în artefact.

# --- install.sh: importul workflow-urilor și al credențialelor placeholder prin API-ul n8n ---
# Adresa la care răspunde n8n DE PE ORCA (de obicei localhost; prin Tailscale, de pe Mac, poate fi http://orca:5678).
N8N_URL=http://localhost:5678
# Cheia de API: în n8n → Settings → n8n API → Create an API key. Se poate șterge după instalare.
N8N_API_KEY=<<TODO>>

# --- docker-compose.cloudflared.yml ---
# Rețeaua Docker a stack-ului n8n (docker network ls; ex. n8n_default). cloudflared se atașează la ea ca să vadă containerul n8n.
N8N_NETWORK=<<TODO>>
